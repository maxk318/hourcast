[
  { "type": "heading", "defaultValue": "HourCast" },
  { "type": "submit", "defaultValue": "Save" },
  {
    "type": "section",
    "items": [
      { "type": "heading", "defaultValue": "Display" },
      {
        "type": "select",
        "messageKey": "DISPLAY_MODE",
        "label": "Inner Ring",
        "defaultValue": "0",
        "description": "What to show on the inner ring. Clock Numbers: hour numerals. Hashes: tick marks with larger weather icons. Temperature: hourly temps, uncovering the weather icons and moons.",
        "options": [
          { "label": "Clock Numbers", "value": "0" },
          { "label": "Hashes", "value": "1" },
          { "label": "Temperature", "value": "2" },
          { "label": "None", "value": "3" }
        ]
      },
      {
        "type": "toggle",
        "messageKey": "SHOW_TIDE",
        "label": "Show tide levels",
        "description": "Draws a blue tank behind each hour showing the tide level, when a tide station is available at your location.",
        "defaultValue": false
      },
      {
        "type": "input",
        "messageKey": "TIDE_STATION",
        "id": "tideStation",
        "label": "Nearest tide station",
        "defaultValue": "None nearby",
        "attributes": { "readonly": "readonly" }
      },
      {
        "type": "toggle",
        "messageKey": "USE_MANUAL_TIDE",
        "label": "Choose station manually",
        "description": "Override the automatic nearest-station selection.",
        "defaultValue": false
      },
      {
        "type": "select",
        "messageKey": "MANUAL_TIDE_STATION_ID",
        "id": "manualTideStation",
        "label": "Station",
        "defaultValue": "8443970",
        "options": [
          {"label": "Boston, MA",          "value": "8443970"},
          {"label": "The Battery, NY",      "value": "8518750"},
          {"label": "Sandy Hook, NJ",       "value": "8531680"},
          {"label": "Atlantic City, NJ",    "value": "8534720"},
          {"label": "Sewells Point, VA",    "value": "8638610"},
          {"label": "Charleston, SC",       "value": "8665530"},
          {"label": "Mayport, FL",          "value": "8720218"},
          {"label": "Miami Beach, FL",      "value": "8722670"},
          {"label": "Key West, FL",         "value": "8724580"},
          {"label": "Galveston, TX",        "value": "8771450"},
          {"label": "Corpus Christi, TX",   "value": "8775870"},
          {"label": "San Diego, CA",        "value": "9410170"},
          {"label": "Los Angeles, CA",      "value": "9410660"},
          {"label": "Monterey, CA",         "value": "9413450"},
          {"label": "San Francisco, CA",    "value": "9414290"},
          {"label": "Humboldt Bay, CA",     "value": "9418767"},
          {"label": "Port Townsend, WA",    "value": "9444900"},
          {"label": "Seattle, WA",          "value": "9447130"},
          {"label": "Honolulu, HI",         "value": "1612340"},
          {"label": "Juneau, AK",           "value": "9452210"}
        ]
      },
      {
        "type": "toggle",
        "messageKey": "SHOW_DATE",
        "label": "Show date",
        "description": "Shows the day-of-month badge at the 5 o'clock position.",
        "defaultValue": true
      },
      {
        "type": "toggle",
        "messageKey": "SHOW_BATTERY",
        "label": "Show battery always",
        "description": "Always show the battery percentage badge at the 7 o'clock position.",
        "defaultValue": true
      },
      {
        "type": "input",
        "messageKey": "BATTERY_THRESHOLD",
        "label": "Show battery when under this %",
        "description": "Also show battery when charge drops below this level. Set to 0 to disable.",
        "defaultValue": "15",
        "attributes": { "type": "number", "min": "0", "max": "100", "step": "1" }
      }
    ]
  },
  {
    "type": "section",
    "items": [
      { "type": "heading", "defaultValue": "Location" },
      {
        "type": "input",
        "messageKey": "CURRENT_LOC",
        "id": "currentLoc",
        "label": "Current location",
        "defaultValue": "Updates after a weather refresh",
        "attributes": { "readonly": "readonly" }
      },
      {
        "type": "toggle",
        "messageKey": "USE_MANUAL_LOC",
        "label": "Enter coordinates manually",
        "description": "Off uses your phone's GPS. On lets you type a fixed latitude and longitude below.",
        "defaultValue": false
      },
      {
        "type": "input",
        "messageKey": "MANUAL_LAT",
        "label": "Latitude",
        "attributes": { "placeholder": "e.g. 38.8816", "type": "text", "inputmode": "decimal" }
      },
      {
        "type": "input",
        "messageKey": "MANUAL_LON",
        "label": "Longitude",
        "attributes": { "placeholder": "e.g. -77.0910", "type": "text", "inputmode": "decimal" }
      }
    ]
  },
  {
    "type": "section",
    "items": [
      { "type": "heading", "defaultValue": "Weather sensitivity" },
      { "type": "text", "defaultValue": "Precipitation chance is shown as 1-4 marks: rays for rain, flakes for snow, bolts for storms. More marks = higher chance. These cutoffs are editable below." },
      { "type": "heading", "defaultValue": "Marks by chance of precip (%)" },
      { "type": "input", "messageKey": "POP1", "label": "1 mark at this % or higher", "defaultValue": "10", "attributes": { "type": "number", "min": "0", "max": "100", "step": "1" } },
      { "type": "input", "messageKey": "POP2", "label": "2 marks at this % or higher", "defaultValue": "20", "attributes": { "type": "number", "min": "0", "max": "100", "step": "1" } },
      { "type": "input", "messageKey": "POP3", "label": "3 marks at this % or higher", "defaultValue": "40", "attributes": { "type": "number", "min": "0", "max": "100", "step": "1" } },
      { "type": "input", "messageKey": "POP4", "label": "4 marks at this % or higher", "defaultValue": "60", "attributes": { "type": "number", "min": "0", "max": "100", "step": "1" } },
      { "type": "text", "defaultValue": "Below the 1-mark value no precipitation is drawn (clouds only). Lower these to be more conservative (precipitation shows sooner)." },
      { "type": "heading", "defaultValue": "Cloud cover (%)" },
      { "type": "input", "messageKey": "CLOUD_OVERCAST", "label": "Overcast at this % or higher", "defaultValue": "90", "attributes": { "type": "number", "min": "0", "max": "100", "step": "1" } },
      { "type": "input", "messageKey": "CLOUD_CLEAR", "label": "Clear below this %", "defaultValue": "15", "attributes": { "type": "number", "min": "0", "max": "100", "step": "1" } },
      { "type": "text", "defaultValue": "These apply only when no precipitation is shown; between the two values is partly cloudy." },
      { "type": "heading", "defaultValue": "Precip type" },
      { "type": "input", "messageKey": "STORM_CAPE", "label": "Storm at CAPE (J/kg) or higher", "defaultValue": "1500", "attributes": { "type": "number", "min": "0", "step": "50" } },
      { "type": "text", "defaultValue": "A precip hour shows as snow when the forecast shows snow; otherwise a storm when thunderstorms are forecast or CAPE is high; otherwise rain. Snow/rain type comes straight from the forecast." }
    ]
  },
  { "type": "submit", "defaultValue": "Save" }
]
